# ===============================
# Dockerfile.streamlit : Image pour Streamlit
# ===============================

FROM python:3.11-slim

WORKDIR /app

# Installation uv
RUN pip install --no-cache-dir uv

# Copie et installation des dépendances
COPY requirements.txt ./
RUN uv pip install --system -r requirements.txt

# Copie de tout le code source
COPY . .

# Exposition du port Streamlit (Render injecte PORT dynamiquement)
EXPOSE 10000

# Commande de lancement (Streamlit) avec port dynamique Render.
CMD ["sh", "-c", "streamlit run src/app/app.py --server.port=${PORT:-10000} --server.address=0.0.0.0 --server.headless=true"]
